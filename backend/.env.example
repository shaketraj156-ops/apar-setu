ENV=dev
DATABASE_URL=postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@<pooler-host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
MAX_UPLOAD_ROWS=20000
USE_FAKE_REGISTRY=true
ALLOW_INSTITUTION_INTAKE_EDIT=true
SIGNING_SECRET=replace-with-32-or-more-random-characters
VERIFY_RATE_LIMIT_PER_MIN=30
