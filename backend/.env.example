# Application & Database
ENV=dev
APP_NAME=SNAP API
FASTAPI_PORT=8000
DATABASE_URL=postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@<pooler-host>:5432/postgres

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
JWT_SECRET=

# CORS & Upload Limits
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
MAX_UPLOAD_ROWS=20000

# Verification & Registry
USE_FAKE_REGISTRY=true
MOCK_APAAR_REGISTRY_URL=http://localhost:8001
ALLOW_INSTITUTION_INTAKE_EDIT=true
SIGNING_SECRET=replace-with-32-or-more-random-characters
VERIFY_RATE_LIMIT_PER_MIN=30

# Verifiable Credentials (Ed25519)
QR_PRIVATE_KEY_PEM=
QR_PUBLIC_KEY_PEM=
QR_BASE_URL=http://localhost:5173/verify?t=
